        <ArticleTitle Language="eng">Machine learning predicts intensive care mortality from the first six hours of vital signs</ArticleTitle>
        <Pagination><MedlinePgn>1120-1128</MedlinePgn></Pagination>
        <AuthorList CompleteYN="Y">
